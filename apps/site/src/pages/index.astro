---
/**
 * The homepage, from the top: the hero with the resource grid, what the product does (the
 * feature cards), the product demo in three tabs, the code in four, the templates, the section
 * for coding agents, the prices in short, the community, the repository, and the close.
 *
 * Every claim on this page was checked against what the product does today, and every number,
 * field and line of output on it is generated at build time by the code that owns it
 * (`src/data/home.ts` says where each one comes from). The data of the grid and of the `explain`
 * table is synthetic, and the page says so where it is shown.
 */
import CodeSamples from '../components/home/CodeSamples.astro';
import FeatureGrid from '../components/home/FeatureGrid.astro';
import ProductDemo from '../components/home/ProductDemo.astro';
import Templates from '../components/home/Templates.astro';
import ResourceGrid from '../components/ResourceGrid.astro';
import Base from '../layouts/Base.astro';
import { GRID_ROWS } from '../data/grid';
import { MCP_TOOL_COUNT, TERMINAL, TEST_ENVIRONMENT_NOTE, priceStrip, OPEN_SOURCE } from '../data/home';
import {
  DESCRIPTION,
  GITHUB_CONTRIBUTING,
  GITHUB_DISCUSSIONS,
  GITHUB_LICENSE,
  GITHUB_REPO,
  HEADLINE,
} from '../data/site';
import '../styles/figures.css';

const prices = priceStrip();
const terminalLines = TERMINAL.flatMap((step) => [
  { command: true, text: step.command },
  ...step.output.map((text) => ({ command: false, text })),
]);
---

<Base
  title="Bookrail, booking infrastructure for developers"
  description={DESCRIPTION}
  navScript={false}
>
  <div class="home">
  <section class="hero">
    <div class="wrap">
      <div class="hero-top">
        <div>
          <h1>{HEADLINE[0]}<br /><em>{HEADLINE[1]}</em></h1>
          <div class="cta">
            <a class="btn primary" href="/signup/">Get API keys</a>
            <a class="btn" href="/docs/">Read the docs</a>
          </div>
        </div>
        <p class="hero-lede">
          Availability across resources, schedules and time zones. Bookings that cannot double book,
          policies frozen at the sale, payments on your own Stripe, signed webhooks, a CLI and an MCP
          server. One API, and open source.
        </p>
      </div>
      <ResourceGrid />
    </div>
  </section>

  <section class="block" id="product" aria-labelledby="product-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="product-title">The layer under your booking app.<br /><em>What it does today.</em></h2>
      </div>
      <FeatureGrid />
    </div>
  </section>

  <section class="block" id="demo" aria-labelledby="demo-title">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 id="demo-title">See why a slot is not available<br /><em>before your users ask.</em></h2>
      </div>
      <ProductDemo />
    </div>
  </section>

  <section class="block" id="code" aria-label="Code">
    <div class="wrap">
      <CodeSamples />
    </div>
  </section>

  <section class="block" id="templates" aria-labelledby="templates-title">
    <div class="wrap">
      <div class="section-head split-head" data-reveal>
        <h2 id="templates-title">Start from your vertical<br /><em>with a ready configuration.</em></h2>
        <a class="more" href="/docs/cli/#bookrail-init">See all templates</a>
      </div>
      <Templates />
    </div>
  </section>

  <section class="block" id="agents" aria-labelledby="agents-title">
    <div class="wrap two">
      <div data-reveal>
        <h2 id="agents-title">Designed to be driven<br /><em>by a coding agent.</em></h2>
        <p class="lede">
          A CLI with <code>--json</code> everywhere, an MCP server with
          <span data-mcp-count>{MCP_TOOL_COUNT} tools</span>, every documentation page as plain markdown at
          the same URL with <code>.md</code> on the end, and an OpenAPI document generated from the very
          schemas that validate each request.
        </p>
        <div class="cta">
          <a class="btn" href="/docs/for-ai-agents/">Read the agent page</a>
        </div>
      </div>
      <div class="term-frame" data-reveal>
        <pre class="term" data-terminal>{terminalLines.map((line) => line.command ? (
          <span class="line"><span class="p">$</span> {line.text}</span>
        ) : (
          <span class="line d">{line.text === '' ? ' ' : line.text}</span>
        ))}</pre>
        <p class="term-foot">
          Printed by the compiled CLI when this page was built. The second command was answered by the
          availability engine through the API's own serializer, about the synthetic day of the grid.
        </p>
      </div>
    </div>
  </section>

  <section class="price-band" aria-labelledby="price-title">
    <div class="wrap">
      <div class="price-head">
        <h2 id="price-title">Free until it counts.<br /><em>Pay as you grow.</em></h2>
        <a class="btn" href="/pricing/">See pricing</a>
      </div>
      <dl class="price-figures" data-price-strip>
        {
          prices.map((price) => (
            <div>
              <dt>{price.figure}</dt>
              <dd>{price.label}</dd>
            </div>
          ))
        }
      </dl>
      <p class="price-note">
        The test environment: {TEST_ENVIRONMENT_NOTE.toLowerCase()}. Prices exclude VAT.
      </p>
    </div>
  </section>

  <section class="block community" aria-labelledby="community-title">
    <div class="wrap">
      <h2 id="community-title">Join the discussion</h2>
      <p class="lede">
        Ask how to model your case, propose a change, or name a booking case the documentation does
        not cover yet. The conversation is public, on GitHub.
      </p>
      <div class="cta">
        <a class="btn" href={GITHUB_DISCUSSIONS}>GitHub Discussions</a>
        <a class="btn" href={GITHUB_REPO}>Star on GitHub</a>
      </div>
    </div>
  </section>

  <section class="oss" aria-labelledby="oss-title">
    <div class="wrap oss-strip" aria-hidden="true">
      {
        GRID_ROWS.map((row) => (
          <div class="oss-lane">
            {row.slots.map((slot) => (
              <i style={`left:${slot.left}%;width:${slot.width}%`} />
            ))}
          </div>
        ))
      }
    </div>
    <div class="wrap oss-row">
      <h2 id="oss-title">Open source. <em>Read it before you trust it.</em></h2>
      <p>
        {OPEN_SOURCE.license}: the engine, the API, the SDK, the CLI and the MCP server, in one public
        repository.
      </p>
      <nav class="oss-links" aria-label="Repository">
        <a href={GITHUB_REPO}>Repository</a>
        <a href={GITHUB_LICENSE}>Licence</a>
        <a href={GITHUB_CONTRIBUTING}>Contributing</a>
      </nav>
    </div>
  </section>

  <section class="block closing" aria-labelledby="closing-title">
    <div class="wrap">
      <h2 id="closing-title">Book your first slot<br /><em>in about ten minutes.</em></h2>
      <div class="cta">
        <a class="btn primary" href="/signup/">Get API keys</a>
        <a class="btn" href="/docs/">Read the docs</a>
      </div>
    </div>
  </section>
  </div>
</Base>

<script>
  // One file for the whole page: the header, the motion and the tabs.
  //
  // The header's script is imported with a query, `?home`, and that is deliberate. Every other
  // page loads `nav.ts` through the header's own script, and a module two entry points share
  // is split by the bundler into a file of its own, which would make this page load two files.
  // With the query the bundler sees a module of its own, and copies its few lines into this one.
  import '../scripts/nav.ts?home';
  import '../scripts/motion';
  import { initTabs } from '../scripts/tabs';
  initTabs();
</script>
