---
/**
 * The one form on this site.
 *
 * It posts one field to the API and nothing else: no cookie is set, no third party is called,
 * nothing is stored in the browser. What comes back is "check your inbox", which is the whole
 * page. The account is created only when the link in that message is opened, which is what
 * makes an address somebody typed by mistake cost nothing.
 *
 * The API lives on another host, so the browser asks permission first; `/v1/signups` is the
 * only part of the API that answers a cross origin request, and it answers this origin only.
 *
 * The link hands over two keys, a test one and a live one on the Free plan, whose monthly
 * threshold is read from the plan table rather than written here.
 *
 * The keys are issued under the Terms of Service and the Data Processing Agreement, for
 * businesses only: two boxes, both required, the second being the specific approval of the
 * clauses listed in Section 17 that articles 1341 and 1342 of the Italian civil code ask for. The
 * API refuses a request without both (`400 terms_not_accepted`).
 */
import { PLANS } from '@bookrail/shared';
import Base from '../layouts/Base.astro';
import { thousands } from '../data/pricing';

const FREE_INCLUDED = thousands(PLANS.free.bookingsIncluded ?? 0);

/** Build time value: the API this site talks to. A preview build points it somewhere else. */
const API_URL = import.meta.env.PUBLIC_API_URL ?? 'https://api.bookrail.dev';
---

<Base
  title="Get API keys, Bookrail"
  description="Type an address, open the link, get a Bookrail test key and a live key. No password, no waiting for a person."
>
  <div class="wrap prose">
    <h1>Get API keys</h1>
    <p>
      Type an address. We send a link, you open it, and the keys are yours: an account, a
      project, one <code>sk_test_</code> key and one <code>sk_live_</code> key. It takes under
      two minutes and nobody has to read an email at the other end.
    </p>
    <p>
      Prefer the terminal? <code>npx bookrail signup</code> does the same thing and stores both
      keys for you.
    </p>

    <form id="signup-form" class="signup-form" data-api-url={API_URL} novalidate>
      <label class="field">
        <span>Email address</span>
        <input
          id="signup-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="you@example.com"
        />
      </label>
      <label class="field">
        <span>Account name <em>(optional)</em></span>
        <input id="signup-account" name="account_name" type="text" placeholder="Padel Roma" />
      </label>
      <fieldset class="terms">
        <legend class="visually-hidden">Terms</legend>
        <label class="check">
          <input id="signup-accept-terms" name="accept_terms" type="checkbox" required />
          <span
            >I accept the <a href="/terms">Terms of Service</a> and the
            <a href="/dpa">Data Processing Agreement</a> on behalf of my business</span
          >
        </label>
        <label class="check">
          <input id="signup-approve-clauses" name="approve_clauses" type="checkbox" required />
          <span
            >I specifically approve the clauses listed in <a href="/terms#17-specific-approval"
              >Section 17 of the Terms</a
            > (Articles 1341 and 1342 of the Italian Civil Code)</span
          >
        </label>
      </fieldset>
      <button id="signup-submit" class="btn primary" type="submit">Send me a link</button>
    </form>

    <p id="signup-status" class="signup-status" role="status" aria-live="polite"></p>

    <noscript>
      <p>
        This form needs JavaScript, because it posts to the API and there is no server behind
        this page. Run <code>npx bookrail signup</code> instead: it asks for an address, sends
        the same link, and stores both keys for you.
      </p>
    </noscript>

    <h2>What you get</h2>
    <ul>
      <li>A test key, immediately, with the full API behind it, free and never counted.</li>
      <li>
        A live key on the <a href="/pricing/">Free plan</a>: up to {FREE_INCLUDED} confirmed
        live bookings a month, then new live bookings are refused until the next month or a
        paying plan.
      </li>
      <li>
        Both are shown once. The <a href="/dashboard/">dashboard</a>, where you sign in with a
        link sent to the same address, shows the plan and this month's usage, and makes and
        revokes keys. No password anywhere.
      </li>
    </ul>
    <p>
      Next: the <a href="/docs/quickstart/">quickstart</a> takes you from that key to a
      confirmed booking. What we store about the sign up itself is on the
      <a href="/privacy">privacy page</a>.
    </p>
  </div>
</Base>

<style>
  .signup-form {
    display: grid;
    gap: var(--space-4);
    max-width: 32rem;
    margin: var(--space-6) 0;
  }
  .field {
    display: grid;
    gap: var(--space-2);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .field em {
    font-style: normal;
    color: var(--ink-3);
  }
  .field input {
    height: 40px;
    padding: 0 var(--space-3);
    font: inherit;
    font-size: var(--step-0);
    color: var(--ink);
    background: var(--card);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-control);
  }
  .field input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .terms {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    border: 0;
  }
  .check {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3);
    align-items: start;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .check input {
    width: 16px;
    height: 16px;
    margin: 3px 0 0;
    accent-color: var(--accent);
  }
  .check input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .check a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .signup-form button {
    justify-self: start;
    cursor: pointer;
  }
  .signup-form button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
  .signup-status:empty {
    display: none;
  }
  .signup-status {
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-control);
    background: var(--card);
  }
  .signup-status[data-state='error'] {
    border-color: var(--line-2);
  }
</style>

<script>
  import '../scripts/signup-form';
</script>
