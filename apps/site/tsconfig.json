{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.astro", "**/*.ts", "**/*.mjs"],
  "exclude": ["dist", ".blog-fixture", "node_modules", "test/__screenshots__"],
  "compilerOptions": {
    "strictNullChecks": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
