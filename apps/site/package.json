{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "dev": "node scripts/generate.mjs --preview-legal && astro dev",
    "build": "node scripts/generate.mjs && astro build",
    "preview": "astro preview",
    "check": "node scripts/generate.mjs --preview-legal && astro check",
    "typecheck": "node scripts/generate.mjs --preview-legal && astro check",
    "lint": "eslint scripts test src/data src/scripts src/content.config.ts",
    "test": "vitest run",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.37.7",
    "astro": "5.18.2",
    "lenis": "1.3.26",
    "starlight-openapi": "0.22.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@bookrail/mcp": "workspace:*",
    "@bookrail/shared": "workspace:*",
    "@types/node": "^20.17.10",
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "playwright": "^1.63.0",
    "bookrail": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
