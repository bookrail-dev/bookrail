{
  "name": "@bookrail/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:reset": "tsx src/cli.ts reset",
    "db:status": "tsx src/cli.ts status",
    "db:adopt": "tsx src/cli.ts adopt"
  },
  "dependencies": {
    "@bookrail/shared": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
